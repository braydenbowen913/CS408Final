<% content_for :title, "Welcome" %>
<section class="hero">
  <p class="eyebrow">A little more organized. A lot more focused.</p>
  <h1>Your life, with room to think.</h1>
  <p class="lead text-secondary mt-4 col-lg-8">Welcome to Nexus, the beginning of your personal productivity workspace. Create an account and make space for what matters.</p>
  <div class="d-flex flex-wrap gap-3 mt-4">
    <% if current_user %>
      <%= link_to "Open your dashboard", dashboard_path, class: "btn btn-primary btn-lg" %>
    <% else %>
      <%= link_to "Get started", signup_path, class: "btn btn-primary btn-lg" %>
      <%= link_to "Log in", login_path, class: "btn btn-outline-secondary btn-lg" %>
    <% end %>
  </div>
</section>
<section aria-labelledby="workspace-heading">
  <h2 id="workspace-heading" class="h4 mb-4">One workspace, taking shape</h2>
  <div class="row g-3">
    <% { "Notes" => "Write, organize, and search your private notes.", "Fitness" => "Workout tracking and progress, coming in a later update.", "Finances" => "Personal accounts and spending, planned for a future update.", "Goals" => "A place for measurable ambitions, coming soon." }.each do |name, description| %>
      <div class="col-md-6 col-xl-3"><div class="card h-100"><div class="card-body p-4">
        <span class="badge text-bg-light mb-3"><%= name == "Notes" ? "Available" : "Planned" %></span><h3 class="h5"><%= name %></h3><p class="text-secondary mb-0"><%= description %></p>
      </div></div></div>
    <% end %>
  </div>
</section>
