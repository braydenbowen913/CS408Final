<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Nexus brings your personal workspace together.">
    <title><%= content_for?(:title) ? yield(:title) : "Nexus" %> | Personal workspace</title>
    <%= csrf_meta_tags %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
      body { background: #f6f7fb; color: #20283f; }
      .navbar-brand { font-weight: 800; letter-spacing: .12em; }
      .hero { padding: clamp(3rem, 8vw, 7rem) 0; }
      .hero h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 750; letter-spacing: -.04em; max-width: 800px; }
      .card { border-color: #e3e7f0; border-radius: 1rem; }
      .auth-card { max-width: 480px; margin: 2rem auto; }
      .eyebrow { text-transform: uppercase; letter-spacing: .15em; font-size: .8rem; font-weight: 700; color: #4956b8; }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100">
    <%= render "shared/header" %>
    <main id="main-content" class="container py-4 flex-grow-1">
      <% flash.each do |type, message| %>
        <div role="<%= type == 'alert' ? 'alert' : 'status' %>" class="alert <%= type == 'alert' ? 'alert-danger' : 'alert-success' %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
