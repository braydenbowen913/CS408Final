<% content_for :title, @label.pluralize %>
<%= link_to "Back to notes", notes_path, class: "d-inline-block mb-3" %>
<h1 class="mb-4"><%= @label.pluralize %></h1>
<div class="row g-4">
  <section class="col-md-5"><div class="card"><div class="card-body p-4"><h2 class="h5">New <%= @label.downcase %></h2><%= render "note_groups/form" %></div></div></section>
  <section class="col-md-7" aria-label="Existing groups">
    <% if @groups.none? %><p class="text-secondary">No <%= @label.downcase.pluralize %> yet.</p><% end %>
    <% @groups.each do |group| %>
      <% next unless group.persisted? %>
      <div class="card mb-3"><div class="card-body">
        <h2 class="h5 text-break"><%= link_to group.name, notes_path("#{group.model_name.param_key}_id" => group.id) %></h2>
        <%= link_to "Rename", edit_polymorphic_path(group), class: "btn btn-outline-secondary btn-sm" %>
        <details class="mt-3"><summary class="text-danger">Delete <%= @label.downcase %></summary><p class="small mt-2">Notes in this <%= @label.downcase %> will be kept without this assignment.</p><%= button_to "Delete #{@label.downcase}", group, method: :delete, class: "btn btn-outline-danger btn-sm" %></details>
      </div></div>
    <% end %>
  </section>
</div>
