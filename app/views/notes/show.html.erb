<% content_for :title, @note.title %>
<%= link_to "Back to notes", notes_path, class: "d-inline-block mb-3" %>
<article class="card"><div class="card-body p-4 p-md-5">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
    <h1 class="text-break"><%= @note.title %></h1>
    <%= link_to "Edit note", edit_note_path(@note), class: "btn btn-primary" %>
  </div>
  <div class="d-flex flex-wrap gap-3 mb-4 text-secondary small">
    <% if @note.folder %><%= link_to @note.folder.name, notes_path(folder_id: @note.folder_id), class: "badge text-bg-light text-decoration-none" %><% end %>
    <% if @note.category %><%= link_to @note.category.name, notes_path(category_id: @note.category_id), class: "badge text-bg-light text-decoration-none" %><% end %>
    <span>Updated <%= @note.updated_at.strftime("%b %d, %Y at %H:%M UTC") %></span>
  </div>
  <% if @note.content.present? %>
    <div class="text-break" style="white-space: pre-wrap"><%= @note.content %></div>
  <% else %><p class="text-secondary">This note has no content yet. Edit it to start writing.</p><% end %>
</div></article>
<details class="mt-4">
  <summary class="text-danger">Delete this note</summary>
  <p class="mt-3">Deleting permanently removes this note. This cannot be undone.</p>
  <%= button_to "Permanently delete note", note_path(@note), method: :delete, class: "btn btn-outline-danger" %>
</details>
