<% content_for :title, "Log in" %>
<section class="card auth-card"><div class="card-body p-4 p-md-5">
  <h1 class="h3">Welcome back</h1><p class="text-secondary">Log in to your Nexus workspace.</p>
  <%= form_with url: login_path, local: true do |form| %>
    <div class="mb-3"><%= form.label :email, class: "form-label" %><%= form.email_field :email, value: params[:email], required: true, autocomplete: "email", class: "form-control" %></div>
    <div class="mb-4"><%= form.label :password, class: "form-label" %><%= form.password_field :password, required: true, autocomplete: "current-password", class: "form-control" %></div>
    <%= form.submit "Log in", class: "btn btn-primary w-100" %>
  <% end %>
  <p class="small mt-4 mb-0">New here? <%= link_to "Create an account", signup_path %></p>
</div></section>
