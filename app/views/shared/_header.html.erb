<a href="#main-content" class="visually-hidden-focusable">Skip to content</a>
<header class="bg-white border-bottom">
  <nav class="navbar container d-flex flex-wrap gap-3 py-3" aria-label="Main navigation">
    <%= link_to "NEXUS", root_path, class: "navbar-brand" %>
    <div class="d-flex flex-wrap align-items-center gap-3">
      <%= link_to "Home", root_path, class: "nav-link" %>
      <% if current_user %>
        <%= link_to "Dashboard", dashboard_path, class: "nav-link" %>
        <%= link_to "Notes", notes_path, class: "nav-link" %>
        <%= link_to "Fitness", workouts_path, class: "nav-link" %>
        <%= link_to "Search", search_path, class: "nav-link" %>
        <%= button_to "Log out", logout_path, method: :delete, class: "btn btn-outline-secondary" %>
      <% else %>
        <%= link_to "Log in", login_path, class: "nav-link" %>
        <%= link_to "Create account", signup_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </nav>
</header>
